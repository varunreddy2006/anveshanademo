APP_NAME="AI Industrial Safety Copilot"
API_V1_PREFIX="/api"
DATABASE_URL="sqlite:///./safety_copilot.db"
SECRET_KEY="change-me-in-local-env"
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
FIRE_SMOKE_CONFIDENCE_THRESHOLD=0.5
VISION_CONFIRMATION_FRAMES=3
RISK_WEIGHT_MISSING_HELMET=10
RISK_WEIGHT_MISSING_VEST=10
RISK_WEIGHT_SMOKE=35
RISK_WEIGHT_FIRE=60

# SQLite is the default local development database.
# To switch later to PostgreSQL, change DATABASE_URL to a PostgreSQL SQLAlchemy URL.
